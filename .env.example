# ==============================================================================
# AGROVET LTD (agrovet.ltd) — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env.local or set these variables in your
# hosting provider dashboard (e.g., Vercel Project Settings > Environment Variables).
# NEVER commit actual secrets, API keys, or database credentials to version control.

# ------------------------------------------------------------------------------
# 1. SAFARICOM DARAJA M-PESA API (Lipa na M-Pesa Online STK Push)
# ------------------------------------------------------------------------------
# Environment: 'sandbox' for testing, 'production' for live payments
DARAJA_ENV=production

# Safaricom Developer Portal App Credentials (https://developer.safaricom.co.ke/)
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Business Shortcode: Lipa na M-Pesa Buy Goods Till Number or Paybill Number
DARAJA_BUSINESS_SHORTCODE=876543

# Lipa Na M-Pesa Online Passkey provided by Safaricom upon Till registration
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public HTTPS webhook URL where Safaricom posts payment completion callbacks
DARAJA_CALLBACK_URL=https://agrovet.ltd/api/mpesa-callback

# Account Reference shown on the customer's phone prompt (Max 12 chars)
DARAJA_ACCOUNT_REFERENCE=AgrovetLtd

# Transaction Description
DARAJA_TRANSACTION_DESC="Payment for certified farm inputs"


# ------------------------------------------------------------------------------
# 2. CENTRAL DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection string used for order persistence, stock tracking, and farmer audit logs
DATABASE_URL="postgresql://postgres:your_strong_password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require"

# Direct URL for running database schema migrations (bypassing connection pooling)
DIRECT_URL="postgresql://postgres:your_strong_password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require"


# ------------------------------------------------------------------------------
# 3. MERCHANT ADMIN AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Master username for the /admin portal
ADMIN_USERNAME=agrovet_admin

# Cryptographic password hash generated with Argon2id or bcrypt (cost factor >= 12)
# To generate: node -e "require('bcryptjs').hash('YourStrongPassword', 12, (err, hash) => console.log(hash))"
ADMIN_PASSWORD_HASH=$2a$12$e8xL4.7Pz...hashed_password_here

# 64-character high-entropy secret string used to sign JWT session cookies
SESSION_SECRET=generate_a_random_64_character_hex_string_using_openssl_rand_hex_32

# Admin session validity duration in hours
SESSION_EXPIRY_HOURS=8


# ------------------------------------------------------------------------------
# 4. ORDER NOTIFICATIONS & AGRONOMIST ALERTS
# ------------------------------------------------------------------------------
# Resend API Key for transactional dispatch and receipt emails (https://resend.com)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Email address receiving incoming customer orders and agronomist inquiries
ADMIN_NOTIFICATION_EMAIL=orders@agrovet.ltd

# Africa's Talking SMS API for instant farmer SMS updates (https://africastalking.com)
AT_API_KEY=your_africastalking_api_key_here
AT_USERNAME=agrovet
AT_SENDER_ID=AGROVET


# ------------------------------------------------------------------------------
# 5. PUBLIC STORE METADATA & CONTACT CONFIGURATION
# ------------------------------------------------------------------------------
PUBLIC_STORE_NAME="Agrovet Ltd"
PUBLIC_STORE_DOMAIN="https://agrovet.ltd"
PUBLIC_OFFICIAL_PHONE="+254700000000"
PUBLIC_WHATSAPP_PHONE="254700000000"
PUBLIC_OFFICIAL_EMAIL="orders@agrovet.ltd"
PUBLIC_PHYSICAL_LOCATION="Kirinyaga Road, Agricultural Center, Shop No. 12, Nairobi, Kenya"
PUBLIC_PCPB_REG_STATUS="PCPB Licensed Commercial Agricultural Distributor"
PUBLIC_KEPHIS_CERT_STATUS="KEPHIS Certified Seed Stockist"
